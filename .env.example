# NOMAD Hyper — docker-compose.v2.yml environment template
# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
# (Same pattern as upstream install/management_compose.yaml — the installer normally generates these.)

# --- Core (NOMAD app + MySQL) ---
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PASSWORD=changeme-mysql
NOMAD_VERSION=2.0.0-hyper.0

# --- Hikma Health (profile: health) ---
HIKMA_DB_PASS=changeme-hikma

# --- Docmost (profile: default/docs) ---
DOCMOST_SECRET=changeme-docmost-secret
DOCMOST_DB_PASS=changeme-docmost

# --- BookStack ---
BOOKSTACK_DB_PASS=changeme-bookstack

# --- Vikunja ---
VIKUNJA_DB_PASS=changeme-vikunja
VIKUNJA_JWT_SECRET=changeme-vikunja-jwt

# --- Vaultwarden ---
VAULTWARDEN_ADMIN_TOKEN=changeme-vaultwarden

# --- InfluxDB / Grafana ---
INFLUX_PASSWORD=changeme-influx
GRAFANA_PASSWORD=changeme-grafana

# --- Home Assistant ---
HA_HOST=homeassistant.local

# --- ONLYOFFICE (profile: office) ---
ONLYOFFICE_JWT_SECRET=changeme-onlyoffice-jwt

# --- Postgres (shared: Docmost, Hikma) ---
POSTGRES_PASSWORD=changeme-postgres

# --- NOMAD host (used by Grafana/Vikunja/Docmost links) ---
NOMAD_HOST=localhost